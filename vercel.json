{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/data",
      "destination": "/api/data.json"
    },
    {
      "source": "/api/knowledge",
      "destination": "/api/knowledge.json"
    },
    {
      "source": "/api/docs",
      "destination": "/api/docs.json"
    },
    {
      "source": "/api/docs/:slug*",
      "destination": "/api/docs/:slug*.json"
    },
    {
      "source": "/docs",
      "destination": "/index"
    },
    {
      "source": "/docs/:slug*",
      "destination": "/index"
    }
  ]
}
